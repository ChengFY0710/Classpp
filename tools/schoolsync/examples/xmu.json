{
  "schemaVersion": 1,
  "id": "xmu_example",
  "capabilities": ["WEBVIEW_LOGIN"],
  "displayName": {
    "zh": "厦门大学",
    "en": "Xiamen University"
  },
  "webView": {
    "entryUrl": "https://lnt.xmu.edu.cn/user/index?version=v1",
    "allowedHosts": [
      "lnt.xmu.edu.cn",
      "ids.xmu.edu.cn",
      "c-identity.xmu.edu.cn",
      "pass.xmu.edu.cn"
    ],
    "dataHost": "lnt.xmu.edu.cn",
    "profilePath": "/api/profile",
    "todosPath": "/api/todos",
    "userAgent": "desktop"
  },
  "copy": {
    "headerTitle": {
      "zh": "同步你的厦大账号",
      "en": "Sync your XMU account"
    },
    "headerDescription": {
      "zh": "通过厦大统一身份认证登录，同步课程中心作业与测验",
      "en": "Sign in with XMU Unified Identity to sync Course Center assignments and quizzes"
    },
    "introTitle": {
      "zh": "同步课程中心待办",
      "en": "Sync course center todos"
    },
    "introBody": {
      "zh": "登录厦门大学课程中心后，把未完成的作业同步进待办库。只读取待办列表，不提交作业、不修改任何数据；登录由学校统一身份认证页面完成，App 不保存密码；可随时退出登录并清除数据。",
      "en": "After signing in to the XMU Course Center, unfinished assignments are synced into your todo list. Read-only: no submissions, no data changes. Sign-in happens on the university's official identity page — the app never stores your password. Sign out anytime to wipe stored data."
    },
    "loginSheetTitle": {
      "zh": "登录课程中心",
      "en": "Sign in to Course Center"
    },
    "sourceBadge": {
      "zh": "课程中心",
      "en": "Course Center"
    },
    "groupHomework": {
      "zh": "作业",
      "en": "Assignments"
    },
    "groupQuiz": {
      "zh": "测验",
      "en": "Quizzes"
    },
    "syncNotifTitle": {
      "zh": "课程中心自动同步完成",
      "en": "Course Center auto sync finished"
    },
    "accountChanged": {
      "zh": "检测到课程中心账号变化，请重新登录或清空同步记录",
      "en": "The Course Center account changed. Sign in again or clear sync records."
    },
    "logoutMessage": {
      "zh": "退出后将清除课程中心的登录状态与同步记录。重新登录并同步后，课程中心仍列出的作业会再次导入。",
      "en": "Signing out clears the Course Center session and sync records. After signing in and syncing again, assignments still listed there will be re-imported."
    },
    "switchMessage": {
      "zh": "课程中心账号与上次同步的不一致，继续同步需要先清空旧的同步记录。已导入的待办可保留，或一并删除。",
      "en": "The Course Center account differs from the last sync. Continuing requires clearing the old sync records. Imported todos can be kept or deleted."
    },
    "serviceBusy": {
      "zh": "课程中心服务繁忙，请稍后重试",
      "en": "Course Center is busy, try again later"
    },
    "invalidCredentials": {
      "zh": "学号或密码不正确",
      "en": "Incorrect student ID or password"
    },
    "sessionNotEstablished": {
      "zh": "登录成功但无法读取课程中心数据，请改用网页登录",
      "en": "Signed in but could not read Course Center data. Use the web sign-in instead."
    },
    "autoLoginDisableMessage": {
      "zh": "关闭后将删除已保存的学号与密码。当前登录状态会保留，会话过期后需手动登录。",
      "en": "Turning this off deletes the saved student ID and password. The current sign-in is kept; after the session expires you will need to sign in manually."
    }
  },
  "profile": {
    "uidPath": "id",
    "namePath": "name",
    "avatar": {
      "candidates": [
        "avatar_big_url",
        "avatar_small_url",
        "avatar",
        "avatar_url",
        "avatarUrl",
        "tiny_avatar",
        "small_avatar",
        "photo",
        "portrait"
      ],
      "baseUrl": "https://lnt.xmu.edu.cn",
      "cookieHosts": ["lnt.xmu.edu.cn"]
    }
  },
  "todo": {
    "listPath": "todo_list",
    "keyFields": [
      { "name": "courseId", "path": "course_id" },
      { "name": "id", "path": "id" }
    ],
    "remoteKeyTemplate": "xmu_example:{courseId}:{id}",
    "localIdTemplate": "xmu_example-{courseId}-{id}",
    "fields": {
      "titlePath": "title",
      "courseNamePath": "course_name",
      "typePath": "type",
      "endTimePath": "end_time"
    },
    "endTime": {
      "format": "ISO",
      "zone": "Asia/Shanghai"
    },
    "filters": {
      "requireStudent": "is_student",
      "skipLocked": "is_locked",
      "skipOverdue": true
    },
    "noteTemplate": "课程：{courseName}\n类型：{type}\n{activityUrl}",
    "activityUrlTemplate": "https://lnt.xmu.edu.cn/course/{courseId}/learning-activity#/{id}",
    "autoGroups": [
      { "type": "homework", "group": "homework" },
      { "type": "quiz", "group": "quiz" }
    ]
  },
  "timetable": {
    "entryUrl": "https://jw.xmu.edu.cn/gsapp/sys/wdkbapp/*default/index.do",
    "allowedHosts": [
      "jw.xmu.edu.cn",
      "ids.xmu.edu.cn",
      "pass.xmu.edu.cn"
    ],
    "userAgent": "desktop",
    "introTitle": {
      "zh": "导入教务课表",
      "en": "Import academic timetable"
    },
    "introBody": {
      "zh": "账号登录后，可从教务系统获取本学期课表，自动生成含上课时间与地点的课程；导入只读取课表数据，不会修改教务系统中的任何信息。",
      "en": "After signing in, fetch this semester's timetable from the academic system; class times and locations are filled in automatically. Read-only: nothing in the academic system is modified."
    },
    "defaultName": {
      "zh": "教务课表",
      "en": "Academic Timetable"
    },
    "baseMarker": "/sys/wdkbapp/",
    "semester": {
      "selector": "#myXnxqSelect",
      "global": "currentXnxq",
      "codePath": "XNXQDM",
      "labelPath": "XNXQDM_DISPLAY"
    },
    "requests": {
      "student": {
        "path": "/wdkcb/initXsxx.do",
        "method": "POST",
        "fields": { "XH": "" },
        "idPath": "data.0.XH"
      },
      "schedule": {
        "path": "/wdkcb/queryXspkjg.do",
        "method": "POST",
        "fields": { "XNXQDM": "{semesterCode}", "XH": "{studentId}" }
      },
      "slots": {
        "path": "/wdkcb/queryXsskjc.do",
        "method": "POST",
        "fields": { "XNXQDM": "{semesterCode}" }
      },
      "week": {
        "path": "/wdkcb/getZcxx.do",
        "method": "POST",
        "fields": { "XNXQDM": "{semesterCode}" }
      }
    },
    "slots": {
      "request": "slots",
      "listPath": "data",
      "fields": {
        "code": "DM",
        "name": "MC",
        "order": "PX",
        "start": "KSSJ",
        "end": "JSSJ"
      },
      "timeFormat": "HHMM",
      "excludeNameContains": "中午"
    },
    "courses": {
      "request": "schedule",
      "listPath": "pkjgList",
      "fields": {
        "name": "KCMC",
        "teacher": "JSXM",
        "location": "JASMC",
        "day": "XQ",
        "startSlot": "KSJCDM",
        "endSlot": "JSJCDM",
        "weeks": "ZCBH",
        "note": "KBBZ",
        "code": "KCDM"
      },
      "weeksFormat": "BITMAP",
      "slotRef": "CODE",
      "mergeSameSessions": true
    },
    "term": {
      "source": "CURRENT_WEEK",
      "request": "week",
      "path": "currentZc"
    }
  }
}
