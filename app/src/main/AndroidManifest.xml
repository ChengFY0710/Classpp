<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wakeup 口令导入：下载适配脚本（gitee）+ 无头 WebView 访问 api.wakeup.fun（WebView
         联网同走此权限）。脚本与口令不写日志 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AI 对话拍照（TakePicture 唤系统相机）：只声明特性不声明权限——拍摄由系统相机
         应用完成，本应用不直接用摄像头；无相机设备上该功能入口自然失效 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 待办加入系统日历（运行时授权流程在 UI 层） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 待办添加到系统闹钟（AlarmClock.ACTION_SET_ALARM）：AOSP/小米等时钟应用的
         HandleSetAlarmActivity 以该普通权限做调用方校验，未声明会 SecurityException；
         普通权限安装即授予，无运行时弹窗 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- 通知与提醒：发系统通知（API 33+ 运行时授权，UI 层请求）、开机后重排提醒闹钟。
         精确闹钟：SCHEDULE_EXACT_ALARM 覆盖 12/12L（彼时声明即默认授予）；USE_EXACT_ALARM
         覆盖 13+（自动授予，适用类目即日历/闹钟/日程提醒类应用，无需用户操作）。
         POST_PROMOTED_NOTIFICATIONS：Live Updates 状态栏 chip（promoted ongoing）的
         非运行时权限，缺失则实况通知退化为普通持续通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Classpp">
        <!-- singleTask：点通知复用现有实例（extras 走 onNewIntent），不另起任务栈副本 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Classpp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AI 对话拍照：TakePicture 的输出 URI 经 FileProvider 授权给系统相机应用写入
             （临时文件在 cacheDir/ai_capture/，导入压缩后即删，路径见 res/xml/file_paths.xml） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 闹钟到点（显式 FIRE）+ 系统事件重排（开机/时间/时区/日期，均为受保护广播，
             exported=true 仅意味着系统可投递） -->
        <receiver
            android:name=".data.notification.NotificationAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 每日自动同步：闹钟到点（显式 FIRE，不进 filter）+ 同一组系统事件重排 -->
        <receiver
            android:name=".data.xmu.XmuDailySyncAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>