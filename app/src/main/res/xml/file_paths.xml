<?xml version="1.0" encoding="utf-8"?>
<!-- AI 对话拍照（TakePicture）：系统相机写入 cacheDir/ai_capture/ 的临时文件经 FileProvider
     授权给相机应用读取，导入压缩后即删，所以只开这一段 cache-path。
     应用内更新：已校验的 APK 落在 cacheDir/updates/，经同一 provider 授权给系统安装器。 -->
<paths>
    <cache-path
        name="ai_capture"
        path="ai_capture/" />
    <cache-path
        name="updates"
        path="updates/" />
</paths>
