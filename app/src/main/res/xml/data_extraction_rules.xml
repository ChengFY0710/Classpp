<?xml version="1.0" encoding="utf-8"?><!--
   云备份 / 设备迁移排除规则（API 31+，指导 §8.2）：同 backup_rules.xml——同步映射与
   WebView cookie（课程中心 httpOnly 会话）不随云备份/换机迁移。todos.json 不排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="xmu-sync.json" />
        <exclude domain="file" path="xmu-sync.json.tmp" />
        <exclude domain="file" path="xmu-sync.json.bak" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="xmu-sync.json" />
        <exclude domain="file" path="xmu-sync.json.tmp" />
        <exclude domain="file" path="xmu-sync.json.bak" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
