<?xml version="1.0" encoding="utf-8"?><!--
   云备份 / 设备迁移排除规则（API 31+，指导 §8.2 / §2.6）：同 backup_rules.xml——同步状态
   目录 xmu/ 与多学校通用目录 sync/（含账号信息、id 映射、头像与损坏隔离文件）以及 WebView
   cookie（课程中心 httpOnly 会话）不随云备份/换机迁移；旧根目录单文件排除保留，兜住升级后
   尚未迁移的数据。
   sharedpref/xmu_secure.xml 是自动续期凭据密文，同样排除（Keystore 密钥不随备份迁移）；
   sharedpref/sync_secure.xml 是新校共用凭据（按校分键、Keystore 密文），同因排除；
   sharedpref/sync_prefs.xml 是新校共用每日同步开关（与账号状态成对，排除避免带旧开关）；
   sharedpref/ai_secure.xml 是 AI 连接配置与 API Key 密文，同因同果排除。
   school_prefs.xml 不排除；todos.json 不排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="xmu" />
        <exclude domain="file" path="xmu-sync.json" />
        <exclude domain="file" path="xmu-sync.json.tmp" />
        <exclude domain="file" path="xmu-sync.json.bak" />
        <exclude domain="file" path="sync" />
        <exclude domain="sharedpref" path="xmu_secure.xml" />
        <exclude domain="sharedpref" path="sync_secure.xml" />
        <exclude domain="sharedpref" path="sync_prefs.xml" />
        <exclude domain="sharedpref" path="ai_secure.xml" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="xmu" />
        <exclude domain="file" path="xmu-sync.json" />
        <exclude domain="file" path="xmu-sync.json.tmp" />
        <exclude domain="file" path="xmu-sync.json.bak" />
        <exclude domain="file" path="sync" />
        <exclude domain="sharedpref" path="xmu_secure.xml" />
        <exclude domain="sharedpref" path="sync_secure.xml" />
        <exclude domain="sharedpref" path="sync_prefs.xml" />
        <exclude domain="sharedpref" path="ai_secure.xml" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
